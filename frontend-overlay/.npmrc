# This template deliberately installs each dependency's own current
# latest (see ../setup.sh), rather than a coordinated set of versions
# that were tested together — so a peer-dependency range that's a step
# behind (e.g. a tool still declaring `peer typescript@^5.x` after
# TypeScript 6 ships) is expected occasionally, not a sign anything is
# actually broken. Accept those instead of failing the install; if
# something genuinely doesn't work at the versions this resolves to,
# that'll show up as a real test/build failure, not an ERESOLVE.
legacy-peer-deps=true
